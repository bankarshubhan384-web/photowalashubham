/*
  Cache-Control: no-cache
/api/*
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/film.mp4
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/site-v3.css
  Cache-Control: public, max-age=31536000, immutable
/assets/site-runtime-v3.js
  Cache-Control: public, max-age=31536000, immutable

/assets/customer-v3.css
  Cache-Control: public, max-age=31536000, immutable

/assets/customer-runtime-v3.js
  Cache-Control: public, max-age=31536000, immutable

/assets/owner-v3.css
  Cache-Control: public, max-age=31536000, immutable

/assets/owner-runtime-v3.js
  Cache-Control: public, max-age=31536000, immutable

/assets/photos/*
  Cache-Control: public, max-age=31536000, immutable
/assets/films/*
  Cache-Control: public, max-age=31536000, immutable
/icon-192.png
  Cache-Control: public, max-age=31536000, immutable
/icon-512.png
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable
/favicon-32.png
  Cache-Control: public, max-age=31536000, immutable
